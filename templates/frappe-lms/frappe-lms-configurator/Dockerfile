FROM ${IMAGE_NAME:-ghcr.io/frappe/lms}:${VERSION:-v2.52.0}
ENTRYPOINT ["bash","-c"]
CMD ["sh","-c","exec \"echo \\\"[configurator] starting\\\"; if [[ ${REGENERATE_APPS_TXT} == \\\"1\\\" ]]; then\n  echo \\\"[configurator] regenerating sites/apps.txt\\\";\n  ls -1 apps > sites/apps.txt;\nfi; existing_db_host=$(grep -hs '^' sites/common_site_config.json | jq -r \\\".db_host // empty\\\" 2>/dev/null || true); if [[ -n \\\"${existing_db_host}\\\" ]]; then\n  echo \\\"[configurator] common_site_config.json already configured, skipping\\\";\n  exit 0;\nfi; echo \\\"[configurator] applying bench global config\\\"; bench set-config -g db_host $DB_HOST; bench set-config -gp db_port $DB_PORT; bench set-config -g redis_cache \\\"redis://$REDIS_CACHE\\\"; bench set-config -g redis_queue \\\"redis://$REDIS_QUEUE\\\"; bench set-config -g redis_socketio \\\"redis://$REDIS_SOCKETIO\\\"; bench set-config -gp socketio_port $SOCKETIO_PORT; echo \\\"[configurator] done\\\";\n\""]
