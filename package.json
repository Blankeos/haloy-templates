{
  "name": "haloy-templates",
  "version": "0.1.0",
  "description": "Translate Dokploy templates (docker-compose + template.toml) into Haloy configs.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "haloy-templates": "src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "sync": "bun run src/cli.ts sync",
    "add": "bun run src/cli.ts add",
    "list": "bun run src/cli.ts list",
    "validate": "bash scripts/validate-all.sh",
    "translate": "bun run src/cli.ts translate"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
