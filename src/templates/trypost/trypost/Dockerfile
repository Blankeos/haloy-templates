FROM trypost-trypost
ENTRYPOINT ["/bin/sh","-ec"]
CMD ["cd /var/www/html\nif [ ! -f storage/oauth-private.key ] && [ ! -f storage/oauth-public.key ]; then\n  php artisan passport:keys --no-interaction\nelif [ ! -s storage/oauth-private.key ] || [ ! -s storage/oauth-public.key ]; then\n  echo 'Incomplete Passport key pair: restore both keys from backup.' >&2\n  exit 1\nfi\nphp artisan migrate --force --no-interaction\nphp <<'PHP'\n<?php\nrequire 'vendor/autoload.php';\n$app = require 'bootstrap/app.php';\n$app->make(Illuminate\\Contracts\\Console\\Kernel::class)->bootstrap();\nif (! App\\Models\\User::query()->exists()) {\n    $email = getenv('INITIAL_USER_EMAIL');\n    $password = getenv('INITIAL_USER_PASSWORD');\n    if (! filter_var($email, FILTER_VALIDATE_EMAIL) || strlen($password ?: '') < 16) {\n        throw new RuntimeException('Set INITIAL_USER_EMAIL and a password of at least 16 characters for first startup.');\n    }\n    App\\Actions\\User\\CreateUser::execute([\n        'name' => getenv('INITIAL_USER_NAME') ?: 'Administrator',\n        'email' => $email,\n        'password' => $password,\n        'email_verified_at' => now(),\n    ]);\n}\nPHP\nexec /usr/local/bin/entrypoint.sh\n"]
