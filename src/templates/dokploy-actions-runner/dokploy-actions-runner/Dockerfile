FROM ghcr.io/myoung34/docker-github-actions-runner:2.338.2-ubuntu-noble@sha256:23e3a4a1da30de5b462ad0ae13d901288e803a688075c3b9b5bb79b7148c07fa
ENTRYPOINT ["/bin/bash","-c","set -euo pipefail\nfail() { printf 'Configuration error: %s\\n' \"$1\" >&2; exit 64; }\n[[ \"${ACCESS_TOKEN:-}\" =~ ^[A-Za-z0-9_]+$ ]] || fail 'ACCESS_TOKEN must be a PAT without whitespace, quotes or variable placeholders'\ncase \"${ACCESS_TOKEN}\" in\n  changeme|CHANGEME|replace_me|your_token) fail 'Replace the ACCESS_TOKEN placeholder with a GitHub PAT' ;;\nesac\n[[ \"${RUNNER_NAME:-}\" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || fail 'RUNNER_NAME must be 1-64 letters, digits, dots, underscores or hyphens; start with a letter or digit'\n[[ \"${LABELS:-}\" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(,[A-Za-z0-9][A-Za-z0-9._-]*)*$ ]] || fail 'LABELS must be comma-separated labels without spaces (letters, digits, dots, underscores or hyphens)'\n[[ \"${RUNNER_GROUP:-}\" =~ ^[A-Za-z0-9][A-Za-z0-9\\ ._-]{0,99}$ ]] || fail 'RUNNER_GROUP must be 1-100 letters, digits, spaces, dots, underscores or hyphens; start with a letter or digit'\ncase \"${RUNNER_SCOPE:-}\" in\n  repo)\n    [[ \"${REPO_URL:-}\" =~ ^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$ ]] || fail 'repo scope requires REPO_URL=https://github.com/OWNER/REPO (no trailing slash or .git suffix)'\n    [[ \"${REPO_URL}\" != *.git ]] || fail 'REPO_URL must not have a .git suffix'\n    [[ -z \"${ORG_NAME:-}\" ]] || fail 'Clear ORG_NAME when RUNNER_SCOPE=repo'\n    [[ \"${RUNNER_GROUP}\" == Default ]] || fail 'Custom RUNNER_GROUP is only supported with RUNNER_SCOPE=org'\n    ;;\n  org)\n    [[ \"${ORG_NAME:-}\" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ ]] || fail 'org scope requires an ORG_NAME slug (not a URL)'\n    [[ -z \"${REPO_URL:-}\" ]] || fail 'Clear REPO_URL when RUNNER_SCOPE=org'\n    ;;\n  *) fail 'RUNNER_SCOPE must be exactly repo or org' ;;\nesac\n# Runtime gate: refuse fallback to distro Node after a runner self-update.\nnode_binary=/actions-runner/externals/node24/bin/node\n[[ -x \"${node_binary}\" ]] || fail 'The maintained Node24 runtime is missing; update the image'\n[[ \"$(command -v node)\" == \"${node_binary}\" ]] || fail 'Default node must use the maintained Node24 runtime'\nnode_version=\"$(\"${node_binary}\" --version)\"\n[[ \"${node_version}\" =~ ^v24\\.([0-9]+)\\.([0-9]+)$ ]] || fail 'The maintained Node24 runtime is required'\n(( 10#${BASH_REMATCH[1]} > 22 || (10#${BASH_REMATCH[1]} == 22 && 10#${BASH_REMATCH[2]} >= 1) )) || fail 'Node24 is below the security baseline; update the image'\n# End runtime gate.\nexec /entrypoint.sh ./bin/Runner.Listener run --startuptype service\n"]
