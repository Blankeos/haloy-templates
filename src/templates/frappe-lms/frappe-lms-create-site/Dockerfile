FROM ${IMAGE_NAME:-ghcr.io/frappe/lms}:${VERSION:-v2.52.0}
ENTRYPOINT ["bash","-c"]
CMD ["sh","-c","exec \"wait-for-it -t 300 ${DB_HOST}:${DB_PORT}; wait-for-it -t 120 frappe-lms-redis-cache:6379; wait-for-it -t 120 frappe-lms-redis-queue:6379; export start=`date +%s`; until [[ -n `grep -hs ^ sites/common_site_config.json | jq -r \\\".db_host // empty\\\"` ]] && \\\n  [[ -n `grep -hs ^ sites/common_site_config.json | jq -r \\\".redis_cache // empty\\\"` ]] && \\\n  [[ -n `grep -hs ^ sites/common_site_config.json | jq -r \\\".redis_queue // empty\\\"` ]];\ndo\n  echo \\\"Waiting for sites/common_site_config.json to be created\\\";\n  sleep 5;\n  if (( `date +%s`-start > 120 )); then\n    echo \\\"could not find sites/common_site_config.json with required keys\\\";\n    exit 1\n  fi\ndone; echo \\\"sites/common_site_config.json found\\\"; [[ -d \\\"sites/app.example.com\\\" ]] && echo \\\"app.example.com already exists\\\" && touch sites/app.example.com/.create-site-done && exit 0; sed -i \\\"s/^required_apps.*/required_apps = []/\\\" apps/lms/lms/hooks.py; bench new-site --mariadb-user-host-login-scope='%' --admin-password=${ADMIN_PASSWORD} --db-root-username=root --db-root-password=${DB_ROOT_PASSWORD} ${INSTALL_APP_ARGS} ${SITE_NAME} || exit 1; if [[ ${ENABLE_SCHEDULER} == \\\"1\\\" ]]; then\n  bench --site ${SITE_NAME} enable-scheduler;\nelse\n  echo \\\"Skipping scheduler enable\\\";\nfi; bench --site ${SITE_NAME} clear-cache; touch sites/${SITE_NAME}/.create-site-done;\n\""]
